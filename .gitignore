# Byte-compiled
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Environments
.env
.venv
env/
venv/

# Planning docs and specs stay private. The exceptions are the things the README links to,
# because a public README with dead links is worse than no link: evidence/ holds the
# screenshots and transcripts, and two of the docs are deliverables rather than plans.
#
# docs/notes/ stays private deliberately. Every finding in it that matters is summarised in
# the README's "What broke" section, which is where a reader will actually look.
/docs/*
!/docs/evidence/
!/docs/in-a-client-environment.md
!/docs/recording-shot-list.md

# The corpus is reproducible from a seed and runs to tens of megabytes, so the documents
# themselves do not belong in git. The manifest does, and for a specific reason: it is the
# declared truth the whole project is measured against, a reader needs it to understand what
# the corpus claims, and unlike a PDF it diffs.
#
# pages.sha256 is the determinism contract for the rendered pages and is likewise small
# and diffable, so it is committed too.
/corpus/*
!/corpus/manifest.json
!/corpus/pages.sha256

# The step-0 spike's documents. Regenerated by spike/make_spike_pdfs.py, and the copies that
# matter are already banked under docs/evidence/step-0/.
/spike/inbox/
/spike/answer-key.json

# Extraction output and the artifacts built from it. Every one of these is derived from
# extractions.json, and extractions.json comes from a Cowork run rather than from this repo.
# The run's own copy is banked under docs/evidence/ instead.
/extractions.json
/out/
*.xlsx
!/docs/evidence/**/*.xlsx

# The scorecard is the artifact, so scores.jsonl, scorecard.md and scorecard.png are all
# committed. Nothing in scorecard/ is ignored — this comment exists so the next person does
# not add a blanket rule here.

# macOS
.DS_Store
